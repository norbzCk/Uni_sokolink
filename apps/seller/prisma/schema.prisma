generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SellerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StorefrontStatus {
  ACTIVE
  PAUSED
}

model SellerApplication {
  id               String                 @id @default(uuid()) @db.Uuid
  userId           String                 @unique @db.Uuid
  businessName     String                 @db.VarChar(160)
  businessCategory String                 @db.VarChar(120)
  region           String                 @db.VarChar(80)
  district         String                 @db.VarChar(80)
  phone            String                 @db.VarChar(32)
  description      String                 @db.Text
  status           SellerApplicationStatus @default(PENDING)
  rejectionReason  String?                @db.Text
  submittedAt      DateTime               @default(now()) @db.Timestamptz(3)
  reviewedAt       DateTime?              @db.Timestamptz(3)
  reviewedBy       String?                @db.Uuid
  createdAt        DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @db.Timestamptz(3)

  @@index([status, submittedAt])
}

model SellerProfile {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @unique @db.Uuid
  businessName     String           @db.VarChar(160)
  slug             String           @unique @db.VarChar(180)
  businessCategory String           @db.VarChar(120)
  region           String           @db.VarChar(80)
  district         String           @db.VarChar(80)
  phone            String           @db.VarChar(32)
  email            String?          @db.VarChar(254)
  description      String           @db.Text
  logoData         Bytes?
  logoContentType  String?          @db.VarChar(60)
  status           StorefrontStatus @default(ACTIVE)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)

  @@index([status, businessName])
}
