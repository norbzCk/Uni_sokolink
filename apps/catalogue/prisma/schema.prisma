generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum ProductCondition {
  NEW
  USED
  REFURBISHED
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  slug        String    @unique @db.VarChar(80)
  name        String    @db.VarChar(120)
  description String?   @db.Text
  imageUrl    String?   @db.VarChar(500)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  products Product[]

  @@index([sortOrder])
}

model Product {
  id              String           @id @default(uuid()) @db.Uuid
  sellerId        String           @db.Uuid
  sellerName      String           @db.VarChar(160)
  categoryId      String           @db.Uuid
  name            String           @db.VarChar(200)
  slug            String           @unique @db.VarChar(240)
  description     String           @db.Text
  condition       ProductCondition @default(NEW)
  brand           String?          @db.VarChar(120)
  model           String?          @db.VarChar(120)
  unit            String           @default("piece") @db.VarChar(30)
  priceTzs        Int
  currency        String           @default("TZS") @db.VarChar(3)
  status          ProductStatus    @default(DRAFT)
  rejectionReason String?          @db.Text
  submittedAt     DateTime?        @db.Timestamptz(3)
  approvedAt      DateTime?        @db.Timestamptz(3)
  approvedBy      String?          @db.Uuid
  archivedAt      DateTime?        @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)

  category       Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images         ProductImage[]
  specifications ProductSpecification[]

  @@index([status, createdAt])
  @@index([categoryId, status])
  @@index([sellerId, status])
  @@index([priceTzs])
}

model ProductImage {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @db.Uuid
  data        Bytes
  contentType String   @db.VarChar(60)
  alt         String?  @db.VarChar(200)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductSpecification {
  id        String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  name      String @db.VarChar(120)
  value     String @db.VarChar(300)
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}
