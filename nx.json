{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": { "default": ["{projectRoot}/**/*", "sharedGlobals"], "sharedGlobals": ["{workspaceRoot}/tsconfig.base.json", "{workspaceRoot}/eslint.config.mjs"] },
  "targetDefaults": {
    "build": { "cache": true, "inputs": ["default", "^default"], "outputs": ["{projectRoot}/dist"] },
    "test": { "cache": true, "inputs": ["default", "^default"] }, "lint": { "cache": true, "inputs": ["default", "^default"] }
  },
  "plugins": [
    { "plugin": "@nx/eslint/plugin", "options": { "targetName": "lint" } },
    { "plugin": "@nx/vite/plugin", "options": { "buildTargetName": "build", "testTargetName": "test", "serveTargetName": "serve" } }
  ]
}
