{
  "name": "sokolink",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "format:check": "prettier --check .",
    "dev": "npm run build:libs && nx run-many -t serve --parallel=10",
    "dev:infra": "docker compose up -d postgres rabbitmq",
    "dev:down": "docker compose down",
    "check:boundaries": "nx run-many -t lint",
    "build:libs": "npm run build --workspace=@sokolink/platform && npm run build --workspace=@sokolink/contracts",
    "db:migrate:identity": "node infra/scripts/migrate.js identity",
    "db:migrate:seller": "node infra/scripts/migrate.js seller",
    "db:migrate:catalogue": "node infra/scripts/migrate.js catalogue",
    "db:migrate:inventory": "node infra/scripts/migrate.js inventory",
    "db:migrate:commerce": "node infra/scripts/migrate.js commerce",
    "db:migrate:payment": "node infra/scripts/migrate.js payment",
    "db:migrate:fulfilment": "node infra/scripts/migrate.js fulfilment",
    "db:migrate:notifications": "node infra/scripts/migrate.js notifications",
    "env:init": "node infra/scripts/init-local-env.js"
  },
  "dependencies": {
    "@nestjs/common": "11.1.9",
    "@nestjs/core": "11.1.9",
    "@nestjs/platform-express": "11.1.9",
    "@nestjs/swagger": "11.2.3",
    "@prisma/client": "6.19.0",
    "@tailwindcss/vite": "4.1.17",
    "amqplib": "0.10.9",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "dotenv": "16.6.1",
    "express": "5.1.0",
    "pg": "8.16.3",
    "pino": "10.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.9.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@nx/eslint": "23.0.0",
    "@nx/js": "23.0.0",
    "@nx/nest": "23.0.0",
    "@nx/react": "23.0.0",
    "@nx/vite": "23.0.0",
    "@nx/workspace": "23.0.0",
    "@testing-library/react": "16.3.0",
    "@types/amqplib": "0.10.7",
    "@types/express": "5.0.5",
    "@types/node": "22.19.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "@vitest/coverage-v8": "4.0.8",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "27.2.0",
    "prettier": "3.6.2",
    "prisma": "6.19.0",
    "tailwindcss": "4.1.17",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vite": "7.2.2",
    "vitest": "4.0.8",
    "nx": "23.0.0",
    "@nx/eslint-plugin": "23.0.0",
    "@testing-library/dom": "10.4.1"
  }
}
