# Copy to .env and set unique local-only values. Do not commit .env.
NODE_ENV=development
POSTGRES_USER=sokolink_local
POSTGRES_PASSWORD=replace-with-a-local-secret
POSTGRES_PORT=5432
IDENTITY_DB_PASSWORD=replace-with-a-distinct-local-secret
SELLER_DB_PASSWORD=replace-with-a-distinct-local-secret
CATALOGUE_DB_PASSWORD=replace-with-a-distinct-local-secret
INVENTORY_DB_PASSWORD=replace-with-a-distinct-local-secret
COMMERCE_DB_PASSWORD=replace-with-a-distinct-local-secret
PAYMENT_DB_PASSWORD=replace-with-a-distinct-local-secret
FULFILMENT_DB_PASSWORD=replace-with-a-distinct-local-secret
NOTIFICATIONS_DB_PASSWORD=replace-with-a-distinct-local-secret
RABBITMQ_USER=sokolink_local
RABBITMQ_PASSWORD=replace-with-a-local-secret
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
WEB_PORT=5173
GATEWAY_PORT=3000
IDENTITY_SERVICE_URL=http://localhost:3101
SELLER_SERVICE_URL=http://localhost:3102
CATALOGUE_SERVICE_URL=http://localhost:3103
INVENTORY_SERVICE_URL=http://localhost:3104
COMMERCE_SERVICE_URL=http://localhost:3105
PAYMENT_SERVICE_URL=http://localhost:3106
FULFILMENT_SERVICE_URL=http://localhost:3107
NOTIFICATIONS_SERVICE_URL=http://localhost:3108
INTERNAL_SERVICE_TOKEN=replace-with-a-random-internal-token
ACCESS_TOKEN_ISSUER=http://localhost:3000
ACCESS_TOKEN_AUDIENCE=sokolink-web
ACCESS_TOKEN_SIGNING_KEY=replace-with-at-least-32-random-bytes
VITE_API_BASE_URL=http://localhost:3000/api/v1
WEB_APP_URL=http://localhost:5173
# For local service processes. Use URL-safe values in local passwords, or URL-encode credentials.
AMQP_URL=amqp://sokolink_local:replace-with-a-local-secret@localhost:5672

API_GATEWAY_PORT=3000
IDENTITY_PORT=3101
SELLER_PORT=3102
CATALOGUE_PORT=3103
INVENTORY_PORT=3104
COMMERCE_PORT=3105
PAYMENT_PORT=3106
FULFILMENT_PORT=3107
NOTIFICATIONS_PORT=3108

# Used only by the explicit SUPER_ADMIN seed command. Never commit real values.
SUPER_ADMIN_FULL_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PHONE=
SUPER_ADMIN_PASSWORD=
ALLOW_SUPER_ADMIN_SEED=false

# Optional local email/SMS delivery. When unset in development, messages are written to /tmp outboxes.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=SokoLink <no-reply@sokolink.local>
# SMS_PROVIDER=development-file
