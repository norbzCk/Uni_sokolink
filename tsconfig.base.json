{
  "compilerOptions": {
    "target": "ES2022", "module": "commonjs", "moduleResolution": "node", "lib": ["ES2022"],
    "strict": true, "noImplicitOverride": true, "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true, "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true, "skipLibCheck": true, "declaration": true,
    "sourceMap": true, "baseUrl": ".", "paths": {
      "@sokolink/platform": ["libs/platform/src/index.ts"], "@sokolink/contracts": ["libs/contracts/src/index.ts"]
    }
  }
}
